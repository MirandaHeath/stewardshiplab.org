---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Not found"
  description="We couldn't find the page you're looking for."
>
  <div class="container">
    <div class="not-found">
      <h1 class="page-title">Oops!</h1>
      <p class="text-l">
        We couldn't find the page you're looking for.
      </p>
      <p>
        Try using the navigation above, and if you still run into issues, please
        <a href="/contact">contact us</a>.
      </p>
    </div>
  </div>
</MainLayout>

<style>
.not-found {
  max-width: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20px;
  margin: 0 auto;
  text-align: center;
  h1, p {
    margin: 0;
    text-wrap: balance;
  }
}
</style>
