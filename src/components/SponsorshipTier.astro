---
import { formatGbpAmount } from '../utils/format.ts';

interface Props {
  name: string;
  price: number;
}

let { name, price } = Astro.props;
---

<div class="tier">
  <div class="tier__meta">
    <h3>{name}</h3>
    <div class="tier__price">
      {price && <span>{formatGbpAmount(price)}+/year</span>}
      {!price && <span>All lower amounts</span>}
    </div>
  </div>
  <div class="tier__body">
    <slot />
    {price && <small>+ all benefits from lower tiers</small>}
  </div>
</div>

<style>
.tier {
  display: flex;
  gap: 45px;
  padding: 20px;
  border-radius: var(--border-radius-s);
  background: var(--color-beige-xpale);
  @media (max-width: 900px) {
    flex-direction: column;
    gap: 15px;
  }
  .tier__meta {
    flex-basis: 280px;
    @media (max-width: 900px) {
      flex-basis: unset;
      text-align: center;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--color-beige-pale);
    }
    h3 {
      display: inline-block;
      margin: 0;
      padding: 3px 8px;
      border-radius: var(--border-radius-s);
      font-family: var(--font-family-sans);
      font-variant-caps: small-caps;
      font-feature-settings: "smcp";
      text-transform: lowercase;
      background: var(--color-blue);
      color: white;
    }
    .tier__price {
      margin-top: 10px;
      font-family: var(--font-family-sans);
    }
  }
  .tier__body {
    flex: 1;
    :global(ul) {
      margin: 0;
      padding: 0;
      list-style: none;
      :global(li) {
        &:after {
          content: '';
          display: block;
          max-width: 50px;
          margin: 15px 0;
          border-bottom: 1px solid var(--color-beige-pale);
        }
        & > :global(small) {
          display: block;
          margin-top: 2px;
        }
      }
    }
    & > small {
      display: block;
      margin-top: 10px;
    }
    &:not(:has(> small)) {
      ul li:last-child:after {
        display: none;
      }
    }
  }
}
</style>
