---
import PostListItem from './PostListItem.astro';
import { POST_CATEGORIES } from '../data/content.ts';

interface Props {
  posts: []object;
  categorised: boolean;
  featuredOnly: boolean;
}

let { posts, categorised, featuredOnly } = Astro.props;
posts = posts.filter((d) => !d.hidden);

const postsByCategory = posts.reduce((cats, post) => {
  if (!(post.category in cats)) {
    cats[post.category] = [];
  }
  cats[post.category].push(post);
  return cats;
}, {});
---

<div class="post-list">
  {featuredOnly && posts.filter((d) => d.featured).map((post) => (
    <div class="post-list-item-container">
      <PostListItem post={post} />
    </div>
  ))}
  {!featuredOnly && categorised && (
    <div class="post-list-category-set">
      {Object.keys(POST_CATEGORIES).filter((category) => category in postsByCategory).map((category) => (
        <div class="post-list-category">
          <div class="post-list-category__details">
            <h2>{POST_CATEGORIES[category].name}</h2>
            <p>{POST_CATEGORIES[category].description}</p>
          </div>
          <div class="post-list-item-set">
            {postsByCategory[category].map((post) => (
              <div class="post-list-item-container">
                <PostListItem post={post} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}
  {!featuredOnly && !categorised && posts.map((post) => (
    <div class="post-list-item-container">
      <PostListItem post={post} />
    </div>
  ))}
</div>

<style>
.post-list {
  .post-list-category-set {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .post-list-category {
    display: flex;
    gap: 45px;
    @media (max-width: 900px) {
      flex-direction: column;
      gap: 20px;
    }
    .post-list-category__details {
      flex-shrink: 0;
      flex-basis: 200px;
      @media (max-width: 900px) {
        flex-basis: unset;
        max-width: 280px;
        margin: 0 auto;
        text-align: center;
      }
      h2 {
        margin-bottom: 3px;
        font-size: var(--font-size-m);
        line-height: 20px;
        font-family: var(--font-family-sans);
        font-variant-caps: small-caps;
        font-feature-settings: "smcp";
        text-transform: lowercase;
      }
      p {
        margin-top: 0;
        font-size: var(--font-size-xs);
        line-height: var(--line-height-xs);
        color: var(--color-text-pale);
        text-wrap: balance;
      }
    }
    .post-list-item-set {
      flex-grow: 1;
    }
  }
  .post-list-item-container {
    margin: 10px 0;
    &:first-child {
      margin-top: 0;
    }
    &:last-child {
      margin-bottom: 0;
    }
  }
}
</style>
