---
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/format.ts';
import { PEOPLE } from '../data/content.ts';

const media = (await getCollection('media'))
  .map((d) => d.data)
  .sort((a, b) => b.date.localeCompare(a.date));
---

<div class="container">
  <div class="media-list">
    {media.map((item) => (
      <a class="media-list-item plain-link" href={item.url}>
        <div class="media-list-item__image" style={`background-image: url(${item.image})`}></div>
        <h3>{item.title}</h3>
        <div class="media-list-item__people">
          {item.guests && item.guests.map((guest) => (
            <div class="media-list-item__person">
              <img src={PEOPLE[guest].image} alt={`A portrait of ${PEOPLE[guest].name}`}>
              <span>{PEOPLE[guest].name}</span>
            </div>
          ))}
          {item.hosts && item.hosts.map((host) => (
            <div class="media-list-item__person">
              <img src={PEOPLE[host].image} alt={`A portrait of ${PEOPLE[host].name}`}>
              <span>{PEOPLE[host].name}</span>
            </div>
          ))}
        </div>
        <div class="media-list-item__details">
          {item.venue} &middot; {formatDate(item.date)}
        </div>
      </a>
    ))}
  </div>
</div>

<style>
.media-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  gap: 15px;
  margin: 1rem 0;
  @media (max-width: 900px) {
    gap: 20px;
  }
  a.media-list-item {
    --person-image-size: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px;
    background: var(--color-beige-xpale);
    border-radius: var(--border-radius-s);
    border: 1px solid var(--color-beige-pale);
    text-decoration: none;
    font-size: var(--font-size-xs);
    line-height: var(--line-height-xs);
    transition: background-color 200ms, color 200ms;
    &:hover {
      background: var(--color-beige-pale);
      color: var(--color-text);
    }
    .media-list-item__image {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      width: 100%;
      padding: 10px;
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
      border-radius: var(--border-radius-s);
    }
    .media-list-item__details {
      color: var(--color-text-pale);
    }
    h3 {
      margin: 0;
      font-size: var(--font-size-m);
      line-height: var(--line-height-m);
      text-wrap: balance;
      @media (max-width: 900px) {
        font-size: var(--font-size-l);
        line-height: var(--line-height-l);
      }
    }
    .media-list-item__people {
      flex: 1;
      display: flex;
      justify-content: flex-end;
      flex-direction: column;
      gap: 5px;
      line-height: 15px;
      .media-list-item__person {
        display: flex;
        align-items: center;
        gap: 7px;
        img {
          width: var(--person-image-size);
          height: var(--person-image-size);
          border-radius: 100%;
        }
      }
    }
  }
}
</style>
