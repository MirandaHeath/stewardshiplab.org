      "url": "https://stewardshiplab.org/"
    }
  },
  "projects": [{
    "guid": "open-infrastructure-observatory",
    "name": "The Open Infrastructure Observatory",
    "description": "We are building the components of an observatory that allows users to identify and monitor the world's critical Open Source packages in real time. A public observatory would inform users and companies when dependencies become insecure or unmaintained. It would allow funders to intelligently allocate money to the most critical projects. And it would empower researchers, governments and foundations to understand how Open Source software underpins our global tech infrastructure.",
    "webpageUrl": {
      "url": "https://stewardshiplab.org/#observatory"
    },
